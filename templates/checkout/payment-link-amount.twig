{% extends "checkout/layout.twig" %}

{% block title %}Enter Amount - {{ link.title|default('Payment') }}{% endblock %}

{% block content %}
{% set currency = link.currency|default('BDT') %}
{# Note: not |default(1) here - Twig's default() filter treats 0/'0' as a defined value, so a
   link with min_amount stored as 0 would silently drop the input's floor to 0 while the
   "Minimum" hint below stays hidden. Guard on the value being a positive amount instead. #}
{% set minAmount = link.min_amount is defined and link.min_amount and link.min_amount > 0 ? link.min_amount : 1 %}
<div class="payment-amount-card">
    <h2 class="payment-amount-title">
        {{ link.title|default('Payment Link') }}
    </h2>
    {% if link.description is defined and link.description %}
        <p class="payment-amount-desc">{{ link.description }}</p>
    {% endif %}

    <form method="POST" action="/pay/{{ link.slug }}/submit" class="payment-amount-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
        <div class="payment-amount-field-group">
            <label for="linkAmountInput" class="payment-amount-label">Amount ({{ currency }})</label>
            <div class="payment-amount-input-wrap">
                <input id="linkAmountInput"
                       type="number"
                       name="amount"
                       step="0.01"
                       min="{{ minAmount }}"
                       {% if link.max_amount is defined and link.max_amount %}max="{{ link.max_amount }}"{% endif %}
                       placeholder="0.00"
                       class="payment-amount-input"
                       required
                       autofocus>
                <span class="payment-amount-currency-badge">{{ currency }}</span>
            </div>
            <div class="payment-amount-limits">
                {% if link.min_amount is defined and link.min_amount %}
                    <small class="payment-amount-limit">Minimum: {{ link.min_amount }} {{ currency }}</small>
                {% endif %}
                {% if link.max_amount is defined and link.max_amount %}
                    <small class="payment-amount-limit">Maximum: {{ link.max_amount }} {{ currency }}</small>
                {% endif %}
            </div>
        </div>
        <button type="submit" class="payment-amount-submit">
            <span>Continue to Payment</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
    </form>
</div>
{% endblock %}
