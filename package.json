{
  "name": "ownpay-frontend-linting",
  "version": "1.0.0",
  "type": "module",
  "description": "ESLint, Stylelint, and JSON linting setup for OwnPay static assets",
  "private": true,
  "scripts": {
    "lint:js": "eslint \"public/assets/js/**/*.js\"",
    "lint:css": "stylelint \"public/assets/css/**/*.css\"",
    "lint:json": "eslint \"**/*.json\" --ext .json",
    "lint": "npm run lint:js && npm run lint:css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-jsonc": "^3.4.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.8",
    "postcss-selector-parser": "7.1.6"
  }
}
